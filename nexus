--[[
    NovaUI
    Modern Luau UI Library
    API:
        Library:CreateWindow({...})
        Window:CreateTab({...})
        Tab:CreateSection({...})

        Section:CreateButton({...})
        Section:CreateToggle({...})
        Section:CreateSlider({...})
        Section:CreateDropdown({...})
        Section:CreateTextbox({...})
        Section:CreateKeybind({...})
        Section:CreateLabel({...})

        Window:Notify({...})
        Window:SetTitle(...)
        Window:SetSubtitle(...)
        Window:SetSize(...)
        Library:SetTheme({...})
]]

local Library = {}

--// Services
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--//========================================================
--// Theme
--//========================================================

local DefaultTheme = {
    Background = Color3.fromRGB(13, 14, 18),
    Surface = Color3.fromRGB(18, 19, 24),
    SurfaceLight = Color3.fromRGB(23, 24, 30),
    SurfaceHover = Color3.fromRGB(29, 30, 38),

    Accent = Color3.fromRGB(105, 120, 255),
    AccentHover = Color3.fromRGB(125, 138, 255),

    Text = Color3.fromRGB(242, 243, 247),
    SubText = Color3.fromRGB(145, 148, 160),
    Muted = Color3.fromRGB(100, 103, 114),

    Border = Color3.fromRGB(38, 40, 49),

    Success = Color3.fromRGB(90, 210, 130),
    Warning = Color3.fromRGB(240, 190, 80),
    Error = Color3.fromRGB(235, 90, 95),

    White = Color3.fromRGB(255, 255, 255),
    Black = Color3.fromRGB(0, 0, 0),
}

local Theme = table.clone(DefaultTheme)

--//========================================================
--// Utilities
--//========================================================

local function Tween(Object, Properties, Time, Style, Direction)
    if not Object then
        return
    end

    Time = Time or 0.2
    Style = Style or Enum.EasingStyle.Quint
    Direction = Direction or Enum.EasingDirection.Out

    local TweenObject = TweenService:Create(
        Object,
        TweenInfo.new(Time, Style, Direction),
        Properties
    )

    TweenObject:Play()

    return TweenObject
end

local function Corner(Object, Radius)
    local UI = Instance.new("UICorner")
    UI.CornerRadius = UDim.new(0, Radius or 8)
    UI.Parent = Object

    return UI
end

local function Stroke(Object, Color, Thickness, Transparency)
    local UI = Instance.new("UIStroke")
    UI.Color = Color or Theme.Border
    UI.Thickness = Thickness or 1
    UI.Transparency = Transparency or 0
    UI.Parent = Object

    return UI
end

local function Padding(Object, Left, Right, Top, Bottom)
    local UI = Instance.new("UIPadding")

    UI.PaddingLeft = UDim.new(0, Left or 0)
    UI.PaddingRight = UDim.new(0, Right or 0)
    UI.PaddingTop = UDim.new(0, Top or 0)
    UI.PaddingBottom = UDim.new(0, Bottom or 0)

    UI.Parent = Object

    return UI
end

local function Create(className, properties, parent)
    local Object = Instance.new(className)

    for Property, Value in pairs(properties or {}) do
        Object[Property] = Value
    end

    if parent then
        Object.Parent = parent
    end

    return Object
end

local function GetPlayerGui()
    if not LocalPlayer then
        return nil
    end

    return LocalPlayer:FindFirstChildOfClass("PlayerGui")
        or LocalPlayer:WaitForChild("PlayerGui")
end

local function Clamp(Value, Min, Max)
    return math.clamp(Value, Min, Max)
end

--//========================================================
--// Theme API
--//========================================================

function Library:GetTheme()
    return table.clone(Theme)
end

function Library:SetTheme(NewTheme)
    for Key, Value in pairs(NewTheme or {}) do
        if Theme[Key] ~= nil then
            Theme[Key] = Value
        end
    end
end

--//========================================================
--// Window
--//========================================================

function Library:CreateWindow(Config)
    Config = Config or {}

    local WindowTitle = Config.Title or Config.Name or "NovaUI"
    local WindowSubtitle = Config.Subtitle or "Modern Interface"
    local WindowSize = Config.Size or UDim2.fromOffset(650, 460)

    --// ScreenGui
    local ScreenGui = Create("ScreenGui", {
        Name = "NovaUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })

    local PlayerGui = GetPlayerGui()

    if not PlayerGui then
        error("NovaUI: PlayerGui was not found.")
    end

    ScreenGui.Parent = PlayerGui

    --// Main
    local Main = Create("Frame", {
        Name = "Main",
        Size = WindowSize,
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),

        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        ClipsDescendants = true,
    }, ScreenGui)

    Corner(Main, 12)
    Stroke(Main, Theme.Border, 1)

    --// Shadow
    local Shadow = Create("Frame", {
        Name = "Shadow",
        Size = UDim2.new(1, 20, 1, 20),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),

        BackgroundColor3 = Theme.Black,
        BackgroundTransparency = 0.65,

        BorderSizePixel = 0,
        ZIndex = 0,
    }, ScreenGui)

    Corner(Shadow, 16)
    Main.ZIndex = 2

    --// Header
    local Header = Create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 62),

        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,

        ZIndex = 3,
    }, Main)

    --// Header accent
    local HeaderAccent = Create("Frame", {
        Size = UDim2.new(0, 3, 0.5, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        ZIndex = 4,
    }, Header)

    Corner(HeaderAccent, 3)

    --// Title
    local Title = Create("TextLabel", {
        Name = "Title",

        Size = UDim2.new(1, -150, 0, 24),
        Position = UDim2.new(0, 20, 0, 9),

        BackgroundTransparency = 1,

        Text = WindowTitle,
        TextColor3 = Theme.Text,

        Font = Enum.Font.GothamBold,
        TextSize = 16,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,

        ZIndex = 4,
    }, Header)

    --// Subtitle
    local Subtitle = Create("TextLabel", {
        Name = "Subtitle",

        Size = UDim2.new(1, -150, 0, 18),
        Position = UDim2.new(0, 20, 0, 33),

        BackgroundTransparency = 1,

        Text = WindowSubtitle,
        TextColor3 = Theme.SubText,

        Font = Enum.Font.Gotham,
        TextSize = 11,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,

        ZIndex = 4,
    }, Header)

    --// Minimize
    local Minimize = Create("TextButton", {
        Name = "Minimize",

        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -74, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),

        BackgroundColor3 = Theme.SurfaceLight,
        BackgroundTransparency = 1,

        Text = "−",
        TextColor3 = Theme.SubText,

        Font = Enum.Font.GothamBold,
        TextSize = 18,

        AutoButtonColor = false,
        BorderSizePixel = 0,

        ZIndex = 5,
    }, Header)

    Corner(Minimize, 7)

    --// Close
    local Close = Create("TextButton", {
        Name = "Close",

        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(1, -40, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),

        BackgroundColor3 = Theme.SurfaceLight,
        BackgroundTransparency = 1,

        Text = "×",
        TextColor3 = Theme.SubText,

        Font = Enum.Font.GothamBold,
        TextSize = 17,

        AutoButtonColor = false,
        BorderSizePixel = 0,

        ZIndex = 5,
    }, Header)

    Corner(Close, 7)

    --// Body
    local Body = Create("Frame", {
        Name = "Body",

        Size = UDim2.new(1, 0, 1, -62),
        Position = UDim2.new(0, 0, 0, 62),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ZIndex = 3,
    }, Main)

    --// Sidebar
    local Sidebar = Create("Frame", {
        Name = "Sidebar",

        Size = UDim2.new(0, 155, 1, 0),

        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,

        ZIndex = 3,
    }, Body)

    --// Sidebar separator
    local SidebarSeparator = Create("Frame", {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, -1, 0, 0),

        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,

        ZIndex = 5,
    }, Sidebar)

    --// Tab holder
    local TabHolder = Create("ScrollingFrame", {
        Name = "Tabs",

        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),

        AutomaticCanvasSize = Enum.AutomaticSize.Y,

        ZIndex = 4,
    }, Sidebar)

    local TabLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, TabHolder)

    --// Content
    local Content = Create("Frame", {
        Name = "Content",

        Size = UDim2.new(1, -155, 1, 0),
        Position = UDim2.new(0, 155, 0, 0),

        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        ZIndex = 3,
    }, Body)

    --// Notifications
    local NotificationHolder = Create("Frame", {
        Name = "Notifications",

        Size = UDim2.fromOffset(300, 500),
        Position = UDim2.new(1, -15, 1, -15),
        AnchorPoint = Vector2.new(1, 1),

        BackgroundTransparency = 1,

        ZIndex = 100,
    }, ScreenGui)

    local NotificationLayout = Create("UIListLayout", {
        Padding = UDim.new(0, 8),
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, NotificationHolder)

    --// Window object
    local Window = {}

    Window.ScreenGui = ScreenGui
    Window.Main = Main
    Window.Tabs = {}
    Window.ActiveTab = nil
    Window.Minimized = false
    Window.Closed = false

    --//====================================================
    --// Dragging
    --//====================================================

    local Dragging = false
    local DragStart
    local StartPosition

    Header.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
            DragStart = Input.Position
            StartPosition = Main.Position

            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end

        if Input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )

        Shadow.Position = UDim2.new(
            Main.Position.X.Scale,
            Main.Position.X.Offset + 10,
            Main.Position.Y.Scale,
            Main.Position.Y.Offset + 10
        )
    end)

    --//====================================================
    --// Window methods
    --//====================================================

    function Window:SetTitle(Text)
        Title.Text = tostring(Text)
    end

    function Window:SetSubtitle(Text)
        Subtitle.Text = tostring(Text)
    end

    function Window:SetSize(Size)
        Main.Size = Size
    end

    function Window:SetVisible(State)
        Main.Visible = State
        Shadow.Visible = State
    end

    function Window:Destroy()
        Window.Closed = true
        ScreenGui:Destroy()
    end

    function Window:Notify(Config)
        Config = Config or {}

        local NotificationTitle = Config.Title or "Notification"
        local NotificationContent = Config.Content or Config.Text or ""
        local Duration = Config.Duration or 4
        local NotificationType = Config.Type or "Info"

        local AccentColor = Theme.Accent

        if NotificationType == "Success" then
            AccentColor = Theme.Success
        elseif NotificationType == "Warning" then
            AccentColor = Theme.Warning
        elseif NotificationType == "Error" then
            AccentColor = Theme.Error
        end

        local Notification = Create("Frame", {
            Size = UDim2.fromOffset(290, 70),

            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,

            BackgroundTransparency = 0,

            ZIndex = 101,
        }, NotificationHolder)

        Corner(Notification, 9)
        Stroke(Notification, Theme.Border, 1)

        local Accent = Create("Frame", {
            Size = UDim2.new(0, 3, 1, -20),
            Position = UDim2.new(0, 8, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),

            BackgroundColor3 = AccentColor,
            BorderSizePixel = 0,

            ZIndex = 102,
        }, Notification)

        Corner(Accent, 3)

        local NTitle = Create("TextLabel", {
            Size = UDim2.new(1, -40, 0, 20),
            Position = UDim2.new(0, 22, 0, 10),

            BackgroundTransparency = 1,

            Text = NotificationTitle,
            TextColor3 = Theme.Text,

            Font = Enum.Font.GothamBold,
            TextSize = 13,

            TextXAlignment = Enum.TextXAlignment.Left,

            ZIndex = 102,
        }, Notification)

        local NContent = Create("TextLabel", {
            Size = UDim2.new(1, -40, 0, 30),
            Position = UDim2.new(0, 22, 0, 30),

            BackgroundTransparency = 1,

            Text = NotificationContent,
            TextColor3 = Theme.SubText,

            Font = Enum.Font.Gotham,
            TextSize = 11,

            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,

            ZIndex = 102,
        }, Notification)

        Notification.Position = UDim2.new(
            1,
            300,
            1,
            0
        )

        Tween(
            Notification,
            {
                Position = UDim2.new(1, 0, 0, 0)
            },
            0.35
        )

        task.delay(Duration, function()
            if Notification and Notification.Parent then
                local TweenOut = Tween(
                    Notification,
                    {
                        Position = UDim2.new(1, 320, 0, 0),
                        BackgroundTransparency = 1
                    },
                    0.3
                )

                TweenOut.Completed:Wait()

                if Notification then
                    Notification:Destroy()
                end
            end
        end)

        return Notification
    end

    --//====================================================
    --// Minimize / Close
    --//====================================================

    Minimize.MouseEnter:Connect(function()
        Tween(Minimize, {
            BackgroundTransparency = 0,
            BackgroundColor3 = Theme.SurfaceHover,
            TextColor3 = Theme.Text
        })
    end)

    Minimize.MouseLeave:Connect(function()
        Tween(Minimize, {
            BackgroundTransparency = 1,
            TextColor3 = Theme.SubText
        })
    end)

    Close.MouseEnter:Connect(function()
        Tween(Close, {
            BackgroundTransparency = 0,
            BackgroundColor3 = Theme.Error,
            TextColor3 = Theme.White
        })
    end)

    Close.MouseLeave:Connect(function()
        Tween(Close, {
            BackgroundTransparency = 1,
            TextColor3 = Theme.SubText
        })
    end)

    Minimize.MouseButton1Click:Connect(function()
        Window.Minimized = not Window.Minimized

        if Window.Minimized then
            Tween(Main, {
                Size = UDim2.fromOffset(Main.AbsoluteSize.X, 62)
            }, 0.25)

            Body.Visible = false
        else
            Body.Visible = true

            Tween(Main, {
                Size = WindowSize
            }, 0.25)
        end
    end)

    Close.MouseButton1Click:Connect(function()
        Window:Destroy()
    end)

    --//====================================================
    --// Create Tab
    --//====================================================

    function Window:CreateTab(Config)
        Config = Config or {}

        local TabName = Config.Name or "Tab"
        local TabIcon = Config.Icon or "◆"

        local TabButton = Create("TextButton", {
            Name = TabName,

            Size = UDim2.new(1, 0, 0, 38),

            BackgroundColor3 = Theme.Surface,
            BackgroundTransparency = 1,

            Text = "",

            AutoButtonColor = false,
            BorderSizePixel = 0,

            ZIndex = 5,
        }, TabHolder)

        Corner(TabButton, 7)

        local TabIconLabel = Create("TextLabel", {
            Size = UDim2.fromOffset(24, 38),
            Position = UDim2.new(0, 7, 0, 0),

            BackgroundTransparency = 1,

            Text = TabIcon,
            TextColor3 = Theme.SubText,

            Font = Enum.Font.GothamBold,
            TextSize = 13,

            ZIndex = 6,
        }, TabButton)

        local TabText = Create("TextLabel", {
            Size = UDim2.new(1, -40, 1, 0),
            Position = UDim2.new(0, 37, 0, 0),

            BackgroundTransparency = 1,

            Text = TabName,
            TextColor3 = Theme.SubText,

            Font = Enum.Font.GothamMedium,
            TextSize = 12,

            TextXAlignment = Enum.TextXAlignment.Left,

            ZIndex = 6,
        }, TabButton)

        local TabContent = Create("ScrollingFrame", {
            Name = TabName,

            Size = UDim2.new(1, -30, 1, -30),
            Position = UDim2.new(0, 15, 0, 15),

            BackgroundTransparency = 1,
            BorderSizePixel = 0,

            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,

            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,

            Visible = false,

            ZIndex = 4,
        }, Content)

        local TabPadding = Create("UIPadding", {
            PaddingBottom = UDim.new(0, 10),
        }, TabContent)

        local TabLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 12),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, TabContent)

        local Tab = {}

        Tab.Button = TabButton
        Tab.Content = TabContent
        Tab.Sections = {}

        --// Select
        function Tab:Select()
            if Window.ActiveTab then
                local OldTab = Window.ActiveTab

                Tween(OldTab.Button, {
                    BackgroundTransparency = 1
                })

                Tween(OldTab.Text, {
                    TextColor3 = Theme.SubText
                })

                Tween(OldTab.Icon, {
                    TextColor3 = Theme.SubText
                })

                OldTab.Content.Visible = false
            end

            Window.ActiveTab = Tab

            TabContent.Visible = true

            Tween(TabButton, {
                BackgroundTransparency = 0,
                BackgroundColor3 = Theme.SurfaceHover
            })

            Tween(TabText, {
                TextColor3 = Theme.Text
            })

            Tween(TabIconLabel, {
                TextColor3 = Theme.Accent
            })
        end

        Tab.Text = TabText
        Tab.Icon = TabIconLabel

        --// Hover
        TabButton.MouseEnter:Connect(function()
            if Window.ActiveTab ~= Tab then
                Tween(TabButton, {
                    BackgroundTransparency = 0.5,
                    BackgroundColor3 = Theme.SurfaceHover
                })

                Tween(TabText, {
                    TextColor3 = Theme.Text
                })
            end
        end)

        TabButton.MouseLeave:Connect(function()
            if Window.ActiveTab ~= Tab then
                Tween(TabButton, {
                    BackgroundTransparency = 1
                })

                Tween(TabText, {
                    TextColor3 = Theme.SubText
                })
            end
        end)

        TabButton.MouseButton1Click:Connect(function()
            Tab:Select()
        end)

        --//================================================
        --// Create Section
        --//================================================

        function Tab:CreateSection(Config)
            Config = Config or {}

            local SectionName = Config.Name or "Section"

            local SectionHolder = Create("Frame", {
                Name = SectionName,

                Size = UDim2.new(1, 0, 0, 0),

                BackgroundTransparency = 1,

                AutomaticSize = Enum.AutomaticSize.Y,

                ZIndex = 5,
            }, TabContent)

            local SectionTitle = Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 22),

                BackgroundTransparency = 1,

                Text = string.upper(SectionName),

                TextColor3 = Theme.Muted,

                Font = Enum.Font.GothamBold,
                TextSize = 10,

                TextXAlignment = Enum.TextXAlignment.Left,

                ZIndex = 6,
            }, SectionHolder)

            local Components = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 0, 25),

                BackgroundTransparency = 1,

                AutomaticSize = Enum.AutomaticSize.Y,

                ZIndex = 5,
            }, SectionHolder)

            local ComponentLayout = Create("UIListLayout", {
                Padding = UDim.new(0, 7),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, Components)

            local Section = {}

            Section.Holder = SectionHolder
            Section.Container = Components

            table.insert(Tab.Sections, Section)

            --//============================================
            --// Button
            --//============================================

            function Section:CreateButton(Config)
                Config = Config or {}

                local Name = Config.Name or "Button"
                local Description = Config.Description or ""
                local Callback = Config.Callback

                local Button = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, Description ~= "" and 58 or 42),

                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,

                    Text = "",

                    AutoButtonColor = false,

                    ZIndex = 7,
                }, Components)

                Corner(Button, 8)
                Stroke(Button, Theme.Border, 1)

                local ButtonTitle = Create("TextLabel", {
                    Size = UDim2.new(1, -25, 0, 20),
                    Position = UDim2.new(0, 13, 0, Description ~= "" and 8 or 11),

                    BackgroundTransparency = 1,

                    Text = Name,
                    TextColor3 = Theme.Text,

                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    ZIndex = 8,
                }, Button)

                local ButtonDescription = Create("TextLabel", {
                    Size = UDim2.new(1, -25, 0, 18),
                    Position = UDim2.new(0, 13, 0, 29),

                    BackgroundTransparency = 1,

                    Text = Description,
                    TextColor3 = Theme.SubText,

                    Font = Enum.Font.Gotham,
                    TextSize = 10,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    Visible = Description ~= "",

                    ZIndex = 8,
                }, Button)

                local Arrow = Create("TextLabel", {
                    Size = UDim2.fromOffset(20, 20),
                    Position = UDim2.new(1, -28, 0.5, -10),

                    BackgroundTransparency = 1,

                    Text = "›",
                    TextColor3 = Theme.Muted,

                    Font = Enum.Font.GothamBold,
                    TextSize = 17,

                    ZIndex = 8,
                }, Button)

                Button.MouseEnter:Connect(function()
                    Tween(Button, {
                        BackgroundColor3 = Theme.SurfaceHover
                    })

                    Tween(Arrow, {
                        TextColor3 = Theme.Accent,
                        Position = UDim2.new(1, -25, 0.5, -10)
                    })
                end)

                Button.MouseLeave:Connect(function()
                    Tween(Button, {
                        BackgroundColor3 = Theme.Surface
                    })

                    Tween(Arrow, {
                        TextColor3 = Theme.Muted,
                        Position = UDim2.new(1, -28, 0.5, -10)
                    })
                end)

                Button.MouseButton1Click:Connect(function()
                    if Callback then
                        task.spawn(Callback)
                    end
                end)

                local Object = {}

                Object.Instance = Button

                function Object:SetText(Text)
                    ButtonTitle.Text = tostring(Text)
                end

                function Object:SetVisible(State)
                    Button.Visible = State
                end

                function Object:Destroy()
                    Button:Destroy()
                end

                return Object
            end

            --//============================================
            --// Toggle
            --//============================================

            function Section:CreateToggle(Config)
                Config = Config or {}

                local Name = Config.Name or "Toggle"
                local Description = Config.Description or ""
                local State = Config.Default == true
                local Callback = Config.Callback

                local Toggle = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, Description ~= "" and 58 or 42),

                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,

                    Text = "",

                    AutoButtonColor = false,

                    ZIndex = 7,
                }, Components)

                Corner(Toggle, 8)
                Stroke(Toggle, Theme.Border, 1)

                local ToggleTitle = Create("TextLabel", {
                    Size = UDim2.new(1, -75, 0, 20),
                    Position = UDim2.new(0, 13, 0, Description ~= "" and 8 or 11),

                    BackgroundTransparency = 1,

                    Text = Name,
                    TextColor3 = Theme.Text,

                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    ZIndex = 8,
                }, Toggle)

                local ToggleDescription = Create("TextLabel", {
                    Size = UDim2.new(1, -75, 0, 18),
                    Position = UDim2.new(0, 13, 0, 29),

                    BackgroundTransparency = 1,

                    Text = Description,
                    TextColor3 = Theme.SubText,

                    Font = Enum.Font.Gotham,
                    TextSize = 10,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    Visible = Description ~= "",

                    ZIndex = 8,
                }, Toggle)

                local Switch = Create("Frame", {
                    Size = UDim2.fromOffset(38, 20),
                    Position = UDim2.new(1, -50, 0.5, -10),

                    BackgroundColor3 = State and Theme.Accent or Theme.Border,
                    BorderSizePixel = 0,

                    ZIndex = 8,
                }, Toggle)

                Corner(Switch, 10)

                local Knob = Create("Frame", {
                    Size = UDim2.fromOffset(16, 16),

                    Position = State
                        and UDim2.new(1, -18, 0.5, -8)
                        or UDim2.new(0, 2, 0.5, -8),

                    BackgroundColor3 = Theme.White,
                    BorderSizePixel = 0,

                    ZIndex = 9,
                }, Switch)

                Corner(Knob, 8)

                local function Update(StateValue, FireCallback)
                    State = StateValue

                    Tween(Switch, {
                        BackgroundColor3 = State
                            and Theme.Accent
                            or Theme.Border
                    })

                    Tween(Knob, {
                        Position = State
                            and UDim2.new(1, -18, 0.5, -8)
                            or UDim2.new(0, 2, 0.5, -8)
                    })

                    if FireCallback and Callback then
                        task.spawn(Callback, State)
                    end
                end

                Toggle.MouseEnter:Connect(function()
                    Tween(Toggle, {
                        BackgroundColor3 = Theme.SurfaceHover
                    })
                end)

                Toggle.MouseLeave:Connect(function()
                    Tween(Toggle, {
                        BackgroundColor3 = Theme.Surface
                    })
                end)

                Toggle.MouseButton1Click:Connect(function()
                    Update(not State, true)
                end)

                local Object = {}

                Object.Instance = Toggle

                function Object:SetValue(Value)
                    Update(Value == true, true)
                end

                function Object:GetValue()
                    return State
                end

                function Object:SetText(Text)
                    ToggleTitle.Text = tostring(Text)
                end

                function Object:SetVisible(Value)
                    Toggle.Visible = Value
                end

                function Object:Destroy()
                    Toggle:Destroy()
                end

                return Object
            end

            --//============================================
            --// Slider
            --//============================================

            function Section:CreateSlider(Config)
                Config = Config or {}

                local Name = Config.Name or "Slider"
                local Description = Config.Description or ""

                local Min = Config.Min or 0
                local Max = Config.Max or 100
                local Current = Clamp(
                    Config.Default or Min,
                    Min,
                    Max
                )

                local Callback = Config.Callback

                local Slider = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, Description ~= "" and 70 or 58),

                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,

                    ZIndex = 7,
                }, Components)

                Corner(Slider, 8)
                Stroke(Slider, Theme.Border, 1)

                local SliderTitle = Create("TextLabel", {
                    Size = UDim2.new(1, -70, 0, 20),
                    Position = UDim2.new(0, 13, 0, 8),

                    BackgroundTransparency = 1,

                    Text = Name,
                    TextColor3 = Theme.Text,

                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    ZIndex = 8,
                }, Slider)

                local ValueLabel = Create("TextLabel", {
                    Size = UDim2.fromOffset(50, 20),
                    Position = UDim2.new(1, -62, 0, 8),

                    BackgroundTransparency = 1,

                    Text = tostring(Current),
                    TextColor3 = Theme.Accent,

                    Font = Enum.Font.GothamBold,
                    TextSize = 11,

                    TextXAlignment = Enum.TextXAlignment.Right,

                    ZIndex = 8,
                }, Slider)

                local SliderBackground = Create("Frame", {
                    Size = UDim2.new(1, -26, 0, 5),
                    Position = UDim2.new(0, 13, 1, -17),

                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,

                    ZIndex = 8,
                }, Slider)

                Corner(SliderBackground, 3)

                local SliderFill = Create("Frame", {
                    Size = UDim2.new(
                        (Current - Min) / (Max - Min),
                        0,
                        1,
                        0
                    ),

                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0,

                    ZIndex = 9,
                }, SliderBackground)

                Corner(SliderFill, 3)

                local SliderKnob = Create("Frame", {
                    Size = UDim2.fromOffset(12, 12),

                    Position = UDim2.new(1, -6, 0.5, -6),

                    BackgroundColor3 = Theme.White,
                    BorderSizePixel = 0,

                    ZIndex = 10,
                }, SliderFill)

                Corner(SliderKnob, 6)

                local DraggingSlider = false

                local function SetSlider(Value, FireCallback)
                    Current = Clamp(Value, Min, Max)

                    local Percent = (Current - Min) / (Max - Min)

                    Tween(SliderFill, {
                        Size = UDim2.new(
                            Percent,
                            0,
                            1,
                            0
                        )
                    }, 0.12)

                    ValueLabel.Text = tostring(
                        math.floor(Current * 100) / 100
                    )

                    if FireCallback and Callback then
                        task.spawn(Callback, Current)
                    end
                end

                local function UpdateFromInput(Input)
                    local X = Input.Position.X
                    local StartX = SliderBackground.AbsolutePosition.X
                    local Width = SliderBackground.AbsoluteSize.X

                    local Percent = Clamp(
                        (X - StartX) / Width,
                        0,
                        1
                    )

                    local Value = Min + ((Max - Min) * Percent)

                    SetSlider(Value, true)
                end

                SliderBackground.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        DraggingSlider = true
                        UpdateFromInput(Input)
                    end
                end)

                UserInputService.InputChanged:Connect(function(Input)
                    if DraggingSlider
                        and Input.UserInputType == Enum.UserInputType.MouseMovement then

                        UpdateFromInput(Input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        DraggingSlider = false
                    end
                end)

                local Object = {}

                Object.Instance = Slider

                function Object:SetValue(Value)
                    SetSlider(Value, true)
                end

                function Object:GetValue()
                    return Current
                end

                function Object:SetVisible(Value)
                    Slider.Visible = Value
                end

                function Object:Destroy()
                    Slider:Destroy()
                end

                return Object
            end

            --//============================================
            --// Dropdown
            --//============================================

            function Section:CreateDropdown(Config)
                Config = Config or {}

                local Name = Config.Name or "Dropdown"
                local Options = Config.Options or {}
                local Default = Config.Default or Options[1]
                local Callback = Config.Callback

                local Open = false
                local Current = Default

                local Dropdown = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 58),

                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,

                    ZIndex = 20,
                }, Components)

                Corner(Dropdown, 8)
                Stroke(Dropdown, Theme.Border, 1)

                local DropdownTitle = Create("TextLabel", {
                    Size = UDim2.new(1, -150, 0, 20),
                    Position = UDim2.new(0, 13, 0, 9),

                    BackgroundTransparency = 1,

                    Text = Name,
                    TextColor3 = Theme.Text,

                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    ZIndex = 21,
                }, Dropdown)

                local Selected = Create("TextButton", {
                    Size = UDim2.fromOffset(135, 32),
                    Position = UDim2.new(1, -145, 0, 13),

                    BackgroundColor3 = Theme.SurfaceLight,
                    BorderSizePixel = 0,

                    Text = tostring(Current or "Select"),

                    TextColor3 = Theme.SubText,

                    Font = Enum.Font.GothamMedium,
                    TextSize = 11,

                    AutoButtonColor = false,

                    ZIndex = 22,
                }, Dropdown)

                Corner(Selected, 7)
                Stroke(Selected, Theme.Border, 1)

                local Arrow = Create("TextLabel", {
                    Size = UDim2.fromOffset(20, 20),
                    Position = UDim2.new(1, -25, 0.5, -10),

                    BackgroundTransparency = 1,

                    Text = "⌄",
                    TextColor3 = Theme.SubText,

                    Font = Enum.Font.GothamBold,
                    TextSize = 13,

                    ZIndex = 23,
                }, Selected)

                local OptionsFrame = Create("Frame", {
                    Size = UDim2.new(1, -26, 0, 0),
                    Position = UDim2.new(0, 13, 1, 5),

                    BackgroundColor3 = Theme.SurfaceLight,
                    BorderSizePixel = 0,

                    ClipsDescendants = true,

                    Visible = false,

                    ZIndex = 100,
                }, Dropdown)

                Corner(OptionsFrame, 7)
                Stroke(OptionsFrame, Theme.Border, 1)

                local OptionsList = Create("UIListLayout", {
                    Padding = UDim.new(0, 2),
                }, OptionsFrame)

                local function RefreshOptions()
                    for _, Child in ipairs(OptionsFrame:GetChildren()) do
                        if Child:IsA("TextButton") then
                            Child:Destroy()
                        end
                    end

                    for _, Option in ipairs(Options) do
                        local OptionButton = Create("TextButton", {
                            Size = UDim2.new(1, -8, 0, 30),

                            BackgroundColor3 = Theme.SurfaceLight,
                            BorderSizePixel = 0,

                            Text = tostring(Option),
                            TextColor3 = Theme.SubText,

                            Font = Enum.Font.GothamMedium,
                            TextSize = 11,

                            AutoButtonColor = false,

                            ZIndex = 101,
                        }, OptionsFrame)

                        Corner(OptionButton, 5)

                        OptionButton.MouseEnter:Connect(function()
                            Tween(OptionButton, {
                                BackgroundColor3 = Theme.SurfaceHover,
                                TextColor3 = Theme.Text
                            })
                        end)

                        OptionButton.MouseLeave:Connect(function()
                            Tween(OptionButton, {
                                BackgroundColor3 = Theme.SurfaceLight,
                                TextColor3 = Theme.SubText
                            })
                        end)

                        OptionButton.MouseButton1Click:Connect(function()
                            Current = Option
                            Selected.Text = tostring(Option)

                            Open = false
                            OptionsFrame.Visible = false
                            OptionsFrame.Size = UDim2.new(1, -26, 0, 0)

                            Arrow.Text = "⌄"

                            if Callback then
                                task.spawn(Callback, Option)
                            end
                        end)
                    end

                    local Height = (#Options * 32) + 6

                    return math.min(Height, 180)
                end

                Selected.MouseButton1Click:Connect(function()
                    Open = not Open

                    if Open then
                        local Height = RefreshOptions()

                        OptionsFrame.Visible = true

                        Tween(
                            OptionsFrame,
                            {
                                Size = UDim2.new(
                                    1,
                                    -26,
                                    0,
                                    Height
                                )
                            },
                            0.2
                        )

                        Arrow.Text = "⌃"
                    else
                        Tween(
                            OptionsFrame,
                            {
                                Size = UDim2.new(
                                    1,
                                    -26,
                                    0,
                                    0
                                )
                            },
                            0.2
                        )

                        task.delay(0.2, function()
                            if not Open then
                                OptionsFrame.Visible = false
                            end
                        end)

                        Arrow.Text = "⌄"
                    end
                end)

                local Object = {}

                Object.Instance = Dropdown

                function Object:SetValue(Value)
                    Current = Value
                    Selected.Text = tostring(Value)

                    if Callback then
                        task.spawn(Callback, Value)
                    end
                end

                function Object:GetValue()
                    return Current
                end

                function Object:SetOptions(NewOptions)
                    Options = NewOptions or {}
                    RefreshOptions()
                end

                function Object:SetVisible(Value)
                    Dropdown.Visible = Value
                end

                function Object:Destroy()
                    Dropdown:Destroy()
                end

                return Object
            end

            --//============================================
            --// Textbox
