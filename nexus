            --//============================================
            --// Keybind
            --//============================================

            function Section:CreateKeybind(Config)
                Config = Config or {}

                local Name = Config.Name or "Keybind"
                local Default = Config.Default or Enum.KeyCode.RightShift
                local Callback = Config.Callback

                local CurrentKey = Default
                local Listening = false

                local KeybindFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 46),

                    BackgroundColor3 = Theme.Surface,
                    BorderSizePixel = 0,

                    ZIndex = 7,
                }, Components)

                Corner(KeybindFrame, 8)
                Stroke(KeybindFrame, Theme.Border, 1)

                local KeybindTitle = Create("TextLabel", {
                    Size = UDim2.new(1, -100, 1, 0),
                    Position = UDim2.new(0, 13, 0, 0),

                    BackgroundTransparency = 1,

                    Text = Name,
                    TextColor3 = Theme.Text,

                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,

                    TextXAlignment = Enum.TextXAlignment.Left,

                    ZIndex = 8,
                }, KeybindFrame)

                local KeyButton = Create("TextButton", {
                    Size = UDim2.fromOffset(70, 30),
                    Position = UDim2.new(1, -80, 0.5, -15),

                    BackgroundColor3 = Theme.SurfaceLight,
                    BorderSizePixel = 0,

                    Text = CurrentKey.Name,

                    TextColor3 = Theme.SubText,

                    Font = Enum.Font.GothamBold,
                    TextSize = 10,

                    AutoButtonColor = false,

                    ZIndex = 8,
                }, KeybindFrame)

                Corner(KeyButton, 6)
                Stroke(KeyButton, Theme.Border, 1)

                KeyButton.MouseButton1Click:Connect(function()
                    Listening = true

                    KeyButton.Text = "..."

                    Tween(KeyButton, {
                        BackgroundColor3 = Theme.Accent,
                        TextColor3 = Theme.White
                    })
                end)

                UserInputService.InputBegan:Connect(function(Input, Processed)
                    if Listening then
                        if Input.UserInputType == Enum.UserInputType.Keyboard then
                            CurrentKey = Input.KeyCode
                            KeyButton.Text = CurrentKey.Name
                            Listening = false

                            Tween(KeyButton, {
                                BackgroundColor3 = Theme.SurfaceLight,
                                TextColor3 = Theme.SubText
                            })

                            return
                        end
                    end

                    if Processed then
                        return
                    end

                    if Input.KeyCode == CurrentKey then
                        if Callback then
                            task.spawn(Callback, CurrentKey)
                        end
                    end
                end)

                local Object = {}

                Object.Instance = KeybindFrame

                function Object:SetValue(Key)
                    if typeof(Key) == "EnumItem"
                        and Key.EnumType == Enum.KeyCode then

                        CurrentKey = Key
                        KeyButton.Text = Key.Name
                    end
                end

                function Object:GetValue()
                    return CurrentKey
                end

                function Object:SetVisible(Value)
                    KeybindFrame.Visible = Value
                end

                function Object:Destroy()
                    KeybindFrame:Destroy()
                end

                return Object
            end

            --//============================================
            --// Label
            --//============================================

            function Section:CreateLabel(Config)
                Config = Config or {}

                local Text = Config.Text or Config.Name or "Label"

                local LabelFrame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 35),

                    BackgroundTransparency = 1,

                    ZIndex = 7,
                }, Components)

                local Label = Create("TextLabel", {
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),

                    BackgroundTransparency = 1,

                    Text = Text,
                    TextColor3 = Theme.SubText,

                    Font = Enum.Font.Gotham,
                    TextSize = 11,

                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,

                    ZIndex = 8,
                }, LabelFrame)

                local Object = {}

                Object.Instance = LabelFrame

                function Object:SetText(NewText)
                    Label.Text = tostring(NewText)
                end

                function Object:SetVisible(Value)
                    LabelFrame.Visible = Value
                end

                function Object:Destroy()
                    LabelFrame:Destroy()
                end

                return Object
            end

            return Section
        end

        table.insert(Window.Tabs, Tab)

        if not Window.ActiveTab then
            Tab:Select()
        end

        return Tab
    end

    --//====================================================
    --// Initial animation
    --//====================================================

    Main.Size = UDim2.fromOffset(
        WindowSize.X.Offset * 0.92,
        WindowSize.Y.Offset * 0.92
    )

    Shadow.Size = UDim2.new(1, 20, 1, 20)

    Tween(Main, {
        Size = WindowSize
    }, 0.45)

    return Window
end

return Library
